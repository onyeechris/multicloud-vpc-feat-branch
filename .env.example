# Pulumi Cloud access token (required)
# Generate at: https://app.pulumi.com/account/tokens
# PULUMI_ACCESS_TOKEN=pul-xxxxxxxxxxxxxxxxxxxx

# Pulumi state backend (optional — defaults to Pulumi Cloud)
# Use an S3 bucket for self-hosted state:
PULUMI_BACKEND_URL=s3://my-pulumi-state-bucket

# AWS credentials (required)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1

# Slack notifications (optional)
# Create an Incoming Webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=<your-slack-incoming-webhook-url>

# JWT signing key used to validate bearer tokens on every API route (generate a long random value)
jwt_secret_key=change-me-to-a-long-random-string
